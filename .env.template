# 环境变量配置模板
# 复制此文件为 .env 并修改为实际值

# ============================================
# 网络设备配置
# ============================================

# IO 控制器配置
IO_CONTROLLER_IP=192.168.3.21
IO_CONTROLLER_PORT=8899
IO_CONNECT_TIMEOUT=10

# 视觉服务器配置
VISION_IP=192.168.3.198
VISION_PORT=65432

# Liyou 拧螺丝控制器配置
LIYOU_SERVER_IP=192.168.0.10
LIYOU_SERVER_PORT=5000
LIYOU_SLAVE_ID=0x01

# ============================================
# 机器人配置
# ============================================

# UR 机器人配置
UR_ROBOT_IP=192.168.1.1
UR_DASHBOARD_PORT=29999
UR_RTDE_PORT=30004
UR_SCRIPT_PORT=30002

# Duco 机器人配置
DUCO_ROBOT_IP=192.168.1.2
DUCO_PORT=9090

# Dazu 机器人配置
DAZU_ROBOT_IP=192.168.1.3

# ============================================
# MCP 服务器配置
# ============================================

# MCP 服务器设置
MCP_SERVER_NAME=nonead-robots-mcp
MCP_LOG_LEVEL=INFO

# ============================================
# AI 模型配置
# ============================================

# OpenAI API 配置
OPENAI_API_KEY=your-api-key-here
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4

# ============================================
# 应用配置
# ============================================

# 默认机器人品牌
DEFAULT_ROBOT_BRAND=ur

# 默认加速度和速度
DEFAULT_ACCELERATION=0.3
DEFAULT_VELOCITY=0.3

# 连接重试设置
CONNECTION_RETRY_COUNT=3
CONNECTION_RETRY_DELAY=5
